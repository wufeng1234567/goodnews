# Windows launchers must keep CRLF; source and docs stay LF.
* text=auto
.gitattributes text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary assets
*.ico binary
*.png binary
