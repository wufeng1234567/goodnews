# Copy to .env and fill values. .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=goodnews
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development server used by scripts/start-*.bat and Vite proxy.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# ---------------------------------------------------------------------------
# PostgreSQL (existing Docker service is reused; do not recreate it)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goodnews
POSTGRES_USER=goodnews
POSTGRES_PASSWORD=change-me
DATABASE_ENABLED=true
DATABASE_ECHO=false
# Optional full override; takes precedence over the five values above.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/goodnews

# ---------------------------------------------------------------------------
# Redis (cache only; optional)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Neo4j (started by docker-compose.yml on this machine)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=goodnews_neo4j_dev
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=true

# ---------------------------------------------------------------------------
# OpenAI-compatible LLM (DeepSeek by default)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=3500
LLM_JSON_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------------------
# Fact-check / search / crawler
# ---------------------------------------------------------------------------
FACTCHECK_MAX_EVIDENCE_ROUNDS=2
MAX_CLAIMS=6
MAX_ARTICLE_CHARS=24000
MAX_FACTCHECK_INPUT_CHARS=50000
EVIDENCE_FETCH_TOP_N=3
SEARCH_PROVIDER=google_news_rss
SEARCH_RESULT_LIMIT=8
SEARCH_TIMEOUT_SECONDS=20
CRAWLER_TIMEOUT_SECONDS=45
CRAWLER_PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=20000
# "msedge" reuses Windows Edge; leave empty after `playwright install chromium`.
PLAYWRIGHT_BROWSER_CHANNEL=msedge
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Social platforms: Xiaohongshu / Douyin / Bilibili
# ---------------------------------------------------------------------------
SOCIAL_BROWSER_HEADLESS=true
SOCIAL_BROWSER_TIMEOUT_MS=45000
SOCIAL_STATE_DIR=backend/.browser-profiles
SOCIAL_MAX_COMMENTS_DEFAULT=30
# Optional raw Cookie headers for server deployments. Prefer social-login.bat.
XHS_COOKIE=
DOUYIN_COOKIE=
BILIBILI_COOKIE=

# ---------------------------------------------------------------------------
# Git push credentials (local .env only; never committed)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_replace-me
GITEE_TOKEN=replace-me
